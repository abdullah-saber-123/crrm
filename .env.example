# Odoo external API (optional). When unset, the app runs on built-in demo
# data so it stays fully usable without a live Odoo instance.
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-db-name
ODOO_USERNAME=api-user@example.com
ODOO_API_KEY=your-odoo-api-key

# Login credentials (single admin account). Change these in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123

# Secret used to sign the session cookie. Set a long random value in
# production (e.g. `openssl rand -hex 32`) — anyone who knows this secret
# can forge a valid session.
SESSION_SECRET=dev-only-insecure-secret-change-me

# Postgres connection string for app-owned state (reconciliation
# confirmations, appointments, collection shows, nominations,
# registrations) — required, no fallback. On Vercel, add a Postgres
# database under the project's Storage tab and it sets POSTGRES_URL
# automatically. Elsewhere, use DATABASE_URL (Neon, Supabase, a local
# Postgres, etc).
POSTGRES_URL=postgresql://user:password@host:5432/dbname
